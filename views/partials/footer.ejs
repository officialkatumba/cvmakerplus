  </main>
</div>
<div class="loader-overlay">
  <div>
    <div class="spinner-border mb-3" role="status" aria-hidden="true"></div>
    <h2 class="h5">Generating your professional CV</h2>
    <p class="mb-0">The AI is shaping your Zambian job-market profile.</p>
  </div>
</div>
<div class="sponsor-video-overlay no-print" id="sponsorVideoOverlay" aria-hidden="true">
  <div class="sponsor-video-panel">
    <div class="sponsor-video">
      <video id="sponsorVideo" muted playsinline preload="metadata">
        <source src="/videos/sponsor-1.mp4" type="video/mp4">
      </video>
      <div class="sponsor-fallback">
        <span id="sponsorSlotLabel">Sponsor video 1 of 2</span>
        <strong>Advertise your training, jobs, or services here</strong>
      </div>
    </div>
    <div class="sponsor-video-copy">
      <span class="hero-kicker">Sponsor break</span>
      <h2>Your CV will generate after two short sponsor videos</h2>
      <p>Each sponsor slot runs for 30 seconds. Ad revenue keeps the CV builder free for visitors.</p>
      <div class="sponsor-countdown">
        <strong id="sponsorCountdown">30</strong>
        <span>seconds remaining</span>
      </div>
      <div class="progress sponsor-progress" role="progressbar" aria-label="Sponsor video countdown">
        <div class="progress-bar" id="sponsorProgress"></div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script>
