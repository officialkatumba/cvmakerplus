<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle || 'CV Maker Plus' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="payroll-theme">
<div class="app-shell">
  <nav class="result-nav home-nav no-print" aria-label="Primary navigation">
      <a class="brand-link" href="/">CVMAKERPLUS</a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/start">Create CV</a>
        <% if (currentUser) { %>
          <a href="/dashboard"><%= currentUser.name %></a>
          <form action="/logout" method="post" class="m-0">
            <button class="secondary-button py-2 px-3" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a href="/login">Admin</a>
        <% } %>
      </div>
  </nav>
  <main>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="container mt-3 no-print">
        <div class="alert alert-danger"><%= error %></div>
      </div>
    <% } %>
