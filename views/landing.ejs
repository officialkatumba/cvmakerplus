<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="payroll-theme">
  <nav class="result-nav home-nav" aria-label="Primary navigation">
    <a class="brand-link" href="/">CVMAKERPLUS</a>
    <div class="nav-links">
      <a href="/start">Create CV</a>
      <a href="/login">Admin</a>
    </div>
  </nav>

  <main class="landing-shell">
    <section class="home-hero-banner">
      <div class="hero-copy">
        <p class="eyebrow">Zambia's Free AI CV Maker</p>
        <h1>Create a professional CV for the job you want.</h1>
        <p>Answer a guided form once, let AI improve your wording for Zambian employers, watch sponsor messages, then download a clean Word document.</p>
        <div class="action-row">
          <a class="upload-zone" href="/start"><span>Generate My CV Now</span></a>
          <a class="secondary-button" href="/start">Returning User</a>
        </div>
      </div>
      <div class="banner-metrics" aria-label="Platform CV statistics">
        <div>
          <span><%= stats.usersHelped.toLocaleString() %></span>
          <small>Job seekers helped</small>
        </div>
        <div>
          <span><%= stats.cvsGenerated.toLocaleString() %></span>
          <small>CVs generated</small>
        </div>
      </div>
    </section>

    <section class="operations-panel">
      <p class="eyebrow">How it works</p>
      <h2 class="process-pill">Provide phone + NRC, complete the guided form, wait for two 30-second sponsor messages, then download your Word CV.</h2>
      <p class="panel-copy">Returning users can recover their saved CV using the same phone and NRC, edit it, run AI again, or download the Word file.</p>
    </section>
  </main>

  <footer class="result-footer">
    <span>CVMAKERPLUS public CV workspace</span>
    <span>&copy; <%= new Date().getFullYear() %> CVMAKERPLUS. All rights reserved.</span>
  </footer>
</body>
</html>
